# OfferGraph Backend Environment Configuration

# OpenAI Configuration (Optional: fallback demo mode is used if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Optional: uses local SQLite if not provided)
# SUPABASE_DATABASE_URL=postgresql://user:password@host:port/database
DATABASE_URL=sqlite:///./offergraph.db

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
