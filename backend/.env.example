# OfferGraph Backend Environment Configuration

# Google Cloud Services Configuration
# Get your free Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# (Optional) Google Safe Browsing / Web Risk API key
GOOGLE_SAFE_BROWSING_API_KEY=

# (Optional Alternative) OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Defaults to local SQLite if empty)
# SUPABASE_DATABASE_URL=postgresql://user:password@host:port/database
DATABASE_URL=sqlite:///./offergraph.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
